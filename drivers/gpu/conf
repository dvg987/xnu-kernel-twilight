# drivers/gpu/conf: the GPU.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver ADRENO
	file    bsd/dev/hakios.adreno.c
	file    iokit/Kernel/hakios.gpu.cpp iokitcpp
	help    the Adreno 642L of the SC7280 woken step by step (adreno=N), and HakiosGPU, the IOKit service Mesa and
	help    the window server draw through (gpu=1, adreno_keep=1). Needs the GPU's firmware from the phone (fw-gpu/)

standard iokit/Kernel/hakios.mali.cpp iokitcpp
	help    the Mali-G310 of the Amlogic box (mali=N): Ken-u's Mali-G610 CSF driver with the S7D's clocks; fw/mali_csffw.bin

standard bsd/dev/hakios.hdmitx.c
	help    the Amlogic box's HDMI transmitter (hdmitx=1): the mode U-Boot left and the TV's EDID, read through the SiP calls

standard bsd/dev/hakios.vdec.c
	help    the Amlogic box's video decoders (vdec=1): the DOS block's power, clocks and reset, its registers read back

standard bsd/dev/hakios.hevc.c
	help    the Amlogic box's HEVC decoder (Main, Main 10, up to 4K) behind the decoder node, with vdec=7

standard bsd/dev/hakios.vp9.c
	help    the Amlogic box's VP9 decoder (Profiles 0 and 2, up to 4K) behind the decoder node, with vdec=7

standard bsd/dev/hakios.vp9_prob.c
	help    its probability adaptation, which the core leaves to the CPU

standard bsd/dev/hakios.vplane.c
	help    the Amlogic box's video plane (VD1) under the OSD; for now kern.hakios_vpu, register bring-up commands

standard bsd/dev/hakios.optee.c
	help    a minimal OP-TEE client (optee=N): the secure world's identity and capabilities, and the video decoders'
	help    firmware handed to the video TA (fw/526fc4fc-7ee6-4a12-96e3-83da9565bce8.ta, fw/video_ucode.bin)
